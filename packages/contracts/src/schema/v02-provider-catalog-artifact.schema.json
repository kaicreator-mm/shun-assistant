{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shun:contracts:0.2:v02-provider-catalog-artifact",
  "title": "v02-provider-catalog-artifact",
  "x-contracts-revision": "shun.contracts/0.2",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "catalogRevision": {
          "type": "string",
          "minLength": 1
        },
        "bindingId": {
          "type": "string",
          "minLength": 1
        },
        "scopedVerifierId": {
          "type": "string",
          "minLength": 1
        },
        "catalogManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindingEvidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "const": "windows-x64"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "signerKeyId": {
          "type": "string",
          "minLength": 1
        },
        "curatorSignature": {
          "type": "string",
          "minLength": 1
        },
        "dependencySha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "artifactKind": {
          "type": "string",
          "enum": [
            "CLI",
            "NATIVE_ADDON"
          ]
        },
        "requiredPrivilege": {
          "type": "string",
          "const": "USER"
        },
        "abiRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "providerId",
        "catalogRevision",
        "bindingId",
        "scopedVerifierId",
        "catalogManifestSha256",
        "bindingEvidenceSha256",
        "version",
        "capabilityId",
        "platform",
        "artifactSha256",
        "origin",
        "entrypoint",
        "signerKeyId",
        "curatorSignature",
        "dependencySha256",
        "artifactKind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "catalogRevision": {
          "type": "string",
          "minLength": 1
        },
        "bindingId": {
          "type": "string",
          "minLength": 1
        },
        "scopedVerifierId": {
          "type": "string",
          "minLength": 1
        },
        "catalogManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindingEvidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "const": "windows-x64"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "signerKeyId": {
          "type": "string",
          "minLength": 1
        },
        "curatorSignature": {
          "type": "string",
          "minLength": 1
        },
        "dependencySha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "artifactKind": {
          "type": "string",
          "const": "CLI"
        },
        "requiredPrivilege": {
          "type": "string",
          "const": "ELEVATED"
        },
        "abiRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "providerId",
        "catalogRevision",
        "bindingId",
        "scopedVerifierId",
        "catalogManifestSha256",
        "bindingEvidenceSha256",
        "version",
        "capabilityId",
        "platform",
        "artifactSha256",
        "origin",
        "entrypoint",
        "signerKeyId",
        "curatorSignature",
        "dependencySha256",
        "artifactKind",
        "requiredPrivilege"
      ],
      "additionalProperties": false
    }
  ],
  "x-semantic-validation": [
    "ProviderCatalogArtifactSchema.safeParse"
  ],
  "properties": {
    "origin": {
      "pattern": "^https://(?![^/?#]*@)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifactKind": {
            "const": "NATIVE_ADDON"
          }
        },
        "required": [
          "artifactKind"
        ]
      },
      "then": {
        "required": [
          "abiRevision"
        ]
      }
    }
  ]
}
