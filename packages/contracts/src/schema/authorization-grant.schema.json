{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shun:contracts:0.1:authorization-grant",
  "title": "authorization-grant",
  "x-contracts-revision": "shun.contracts/0.1",
  "type": "object",
  "properties": {
    "grantId": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "object",
      "properties": {
        "authorityId": {
          "type": "string",
          "minLength": 1
        },
        "authorityRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "authorityId",
        "authorityRevision"
      ],
      "additionalProperties": false
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "planHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policySnapshotRevision": {
      "type": "string",
      "minLength": 1
    },
    "actionScope": {
      "type": "object",
      "properties": {
        "actionIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "privilegeLevel": {
          "type": "string",
          "enum": [
            "NONE",
            "USER",
            "ELEVATED"
          ]
        },
        "filesystem": {
          "type": "object",
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "read",
            "write"
          ],
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "allowed"
          ],
          "additionalProperties": false
        },
        "registry": {
          "type": "object",
          "properties": {
            "write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "write"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "actionIds",
        "privilegeLevel"
      ],
      "additionalProperties": false
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "approvalRef": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "HMAC_SHA256",
            "SIGNATURE_ED25519",
            "TRUSTED_LOCAL_CHANNEL"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "grantId",
    "issuer",
    "taskId",
    "planHash",
    "policySnapshotRevision",
    "actionScope",
    "issuedAt",
    "expiresAt",
    "integrity"
  ],
  "additionalProperties": false
}
