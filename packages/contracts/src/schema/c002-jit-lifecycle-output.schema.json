{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shun:contracts:0.1:c002-jit-lifecycle-output",
  "title": "c002-jit-lifecycle-output",
  "x-contracts-revision": "shun.contracts/0.1",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "selectedBindingId": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "official": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "licenseDisposition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "official",
        "version",
        "licenseDisposition"
      ],
      "additionalProperties": false
    },
    "taskResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "verification": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "verifierId": {
              "type": "string",
              "minLength": 1
            },
            "verifierRevision": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INCOMPLETE"
              ]
            },
            "checks": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "checkId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "FAIL",
                      "NOT_RUN",
                      "SKIPPED"
                    ]
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "checkId",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "oracleInputs": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "taskId",
            "verifierId",
            "verifierRevision",
            "status",
            "checks",
            "oracleInputs",
            "evidenceRefs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "verification"
      ],
      "additionalProperties": false
    },
    "lifecycleState": {
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "INSTALLED",
            "RETAINED",
            "REMOVED",
            "REMOVE_FAILED"
          ]
        }
      },
      "required": [
        "providerId",
        "version",
        "state"
      ],
      "additionalProperties": false
    },
    "residueReport": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "type": "string",
                "enum": [
                  "PROGRAM_OWNED",
                  "CACHE",
                  "CONFIGURATION",
                  "USER_CREATED_UNKNOWN",
                  "PROTECTED"
                ]
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "DELETE",
                  "RETAIN"
                ]
              }
            },
            "required": [
              "path",
              "classification",
              "disposition"
            ],
            "additionalProperties": false
          }
        },
        "unknownOrProtectedDeleted": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "candidates",
        "unknownOrProtectedDeleted"
      ],
      "additionalProperties": false
    },
    "r2Gate": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PLAN",
              "PREVIEW",
              "CHECKPOINT",
              "APPROVAL",
              "EXECUTE",
              "VERIFY"
            ]
          }
        },
        "approvedBy": {
          "type": "string",
          "enum": [
            "USER_APPROVAL",
            "DURABLE_POLICY"
          ]
        }
      },
      "required": [
        "phases"
      ],
      "additionalProperties": false
    },
    "finalState": {
      "type": "string",
      "enum": [
        "RETAINED",
        "REMOVED"
      ]
    }
  },
  "required": [
    "taskId",
    "selectedBindingId",
    "provenance",
    "taskResult",
    "lifecycleState",
    "residueReport",
    "finalState"
  ],
  "additionalProperties": false
}
